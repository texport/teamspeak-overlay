<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Material 3 Light Color Scheme -->
    <Color x:Key="md.sys.color.primary">#6750A4</Color>
    <Color x:Key="md.sys.color.on-primary">#FFFFFF</Color>
    <Color x:Key="md.sys.color.primary-container">#EADDFF</Color>
    <Color x:Key="md.sys.color.on-primary-container">#21005D</Color>
    
    <Color x:Key="md.sys.color.secondary">#625B71</Color>
    <Color x:Key="md.sys.color.on-secondary">#FFFFFF</Color>
    <Color x:Key="md.sys.color.secondary-container">#E8DEF8</Color>
    <Color x:Key="md.sys.color.on-secondary-container">#1D192B</Color>

    <Color x:Key="md.sys.color.tertiary">#7D5260</Color>
    <Color x:Key="md.sys.color.on-tertiary">#FFFFFF</Color>
    <Color x:Key="md.sys.color.tertiary-container">#FFD8E4</Color>
    <Color x:Key="md.sys.color.on-tertiary-container">#31111D</Color>
    
    <Color x:Key="md.sys.color.background">#FEF7FF</Color>
    <Color x:Key="md.sys.color.on-background">#1D1B20</Color>
    <Color x:Key="md.sys.color.surface">#FEF7FF</Color>
    <Color x:Key="md.sys.color.on-surface">#1D1B20</Color>

    <Color x:Key="md.sys.color.surface-variant">#E7E0EC</Color>
    <Color x:Key="md.sys.color.on-surface-variant">#49454F</Color>
    
    <Color x:Key="md.sys.color.outline">#79747E</Color>
    <Color x:Key="md.sys.color.outline-variant">#CAC4D0</Color>

    <!-- Specific Overlay Tokens -->
    <Color x:Key="md.sys.color.success">#00C853</Color>
    <Color x:Key="md.sys.color.on-success">#FFFFFF</Color>
    <Color x:Key="md.sys.color.error">#B3261E</Color>
    <Color x:Key="md.sys.color.on-error">#FFFFFF</Color>
    <Color x:Key="md.sys.color.overlay-whisper">#9C27B0</Color>
    <Color x:Key="md.sys.color.on-overlay-whisper">#FFFFFF</Color>
    
    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource md.sys.color.primary}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource md.sys.color.on-primary}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource md.sys.color.primary-container}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource md.sys.color.on-primary-container}" />
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource md.sys.color.background}" />
    <SolidColorBrush x:Key="OnBackgroundBrush" Color="{StaticResource md.sys.color.on-background}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource md.sys.color.surface}" />
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource md.sys.color.on-surface}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource md.sys.color.surface-variant}" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource md.sys.color.on-surface-variant}" />
    
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource md.sys.color.outline}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource md.sys.color.outline-variant}" />
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource md.sys.color.success}" />
    <SolidColorBrush x:Key="OnSuccessBrush" Color="{StaticResource md.sys.color.on-success}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource md.sys.color.error}" />
    <SolidColorBrush x:Key="OnErrorBrush" Color="{StaticResource md.sys.color.on-error}" />
    <SolidColorBrush x:Key="WhisperBrush" Color="{StaticResource md.sys.color.overlay-whisper}" />
    <SolidColorBrush x:Key="OnWhisperBrush" Color="{StaticResource md.sys.color.on-overlay-whisper}" />
</ResourceDictionary>
